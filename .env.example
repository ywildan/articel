# Neon Postgres connection string (gunakan pooled connection / direct)
# Contoh: postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/artikel?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password untuk login dashboard admin (bebas, buat yang kuat)
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Secret untuk menandatangani cookie sesi (minimal 32 karakter acak)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
